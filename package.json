{
  "name": "anvil-obsidian-terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Anvil — a native bottom-dock terminal for Obsidian, built for running Claude Code and other agent CLIs.",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && wdio run ./wdio.conf.mts",
    "dev:launch": "scripts/dev-launch.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "25.6.0",
    "@types/pngjs": "^6.0.5",
    "@wdio/cli": "9.27.0",
    "@wdio/globals": "9.27.0",
    "@wdio/local-runner": "9.27.0",
    "@wdio/mocha-framework": "9.27.0",
    "builtin-modules": "5.1.0",
    "esbuild": "0.28.0",
    "mocha": "11.7.5",
    "obsidian": "1.12.3",
    "pngjs": "^7.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.4",
    "wdio-obsidian-reporter": "3.0.2",
    "wdio-obsidian-service": "3.0.2",
    "webdriverio": "9.27.0"
  }
}
